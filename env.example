# Скопируйте этот файл в .env и заполните значениями.
# .env в .gitignore и не должен попадать в репозиторий.

# Обязательно: OAuth-токен Яндекс.Диска
API_TOKEN=your_yandex_oauth_token_here

# Опционально: переопределение дефолтов из config/settings.py
# BASE_URL=https://cloud-api.yandex.net
# API_VERSION=v1
# TIMEOUT=10
